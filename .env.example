# Crowd Symphony Environment Variables
# Copy this file to .env.local and fill in your values

# Database (Supabase/PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/crowd_symphony"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Analytics & Monitoring
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
SENTRY_DSN="https://...@sentry.io/..."
SENTRY_ORG="your-org"
SENTRY_PROJECT="crowd-symphony"

# Feature Flags
NEXT_PUBLIC_ENABLE_WEBSOCKETS="false"
NEXT_PUBLIC_ENABLE_RECORDING="false"
NEXT_PUBLIC_ENABLE_ADMIN_DASHBOARD="false"

# External Services
VERCEL_KV_REST_API_URL="https://..."
VERCEL_KV_REST_API_TOKEN="..."
VERCEL_KV_REST_API_READ_ONLY_TOKEN="..."

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Crowd Symphony"
NODE_ENV="development"